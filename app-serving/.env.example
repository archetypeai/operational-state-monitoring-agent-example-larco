# Copy to app-serving/.env only to change the defaults below. The API key and
# endpoint are read from the REPO's .env (ATAI_API_ENDPOINT, ATAI_API_KEY), the
# same file the Python stages use, and stay with the serving bridge: the browser
# never sees them. An ATAI_* line here is ignored. Agent serving is on Dev only.
#
# CYCLE=warm_fast-15_0       # the delivery file to start on (part of its name)
# SPEED=1                    # 1, 2, 4 or 8 times real time, or max (as fast as the agent answers)
# WINDOWS_PER_QUERY=1        # 1 to 8 consecutive windows a query
