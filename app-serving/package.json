{
	"name": "larco-osm-serving",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n broker,agent,replay,web -c blue,magenta,yellow,green \"npm run broker\" \"npm run agent\" \"npm run replayer\" \"npm run web\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"web": "vite dev --port 5182 --strictPort",
		"broker": "sh scripts/run-broker.sh",
		"replayer": "node scripts/replayer.js --app=larco-serving",
		"agent": "node scripts/serving-bridge.js --app=larco-serving",
		"stop": "sh scripts/stop.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@archetypeai/ds-lib-tokens": "^0.19.0",
		"@archetypeai/ds-ui-svelte-console": "^0.19.0",
		"@archetypeai/ds-ui-svelte-labs": "^0.19.0",
		"@cfworker/json-schema": "^4.1.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.47.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"d3-contour": "^4.0.2",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "2.0.0-next.46",
		"mode-watcher": "^1.1.0",
		"mqtt": "^5.10.4",
		"shiki": "^3.23.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"yaml": "^2.9.1"
	}
}
